# Copy to .env for local development. Deployed values are set in Coolify,
# not here — .env is untracked so the public repo carries no configuration.

# Local dev uses a file in the project root; the container uses the mounted
# volume instead (file:/app/data/app.db).
DATABASE_URL="file:./dev.db"

# Marks the session cookie Secure. Set to 1 anywhere served over HTTPS.
# COOKIE_SECURE=1

# PORT=3067
